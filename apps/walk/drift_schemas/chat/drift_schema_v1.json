    {
      "name": "conversations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversations\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"title_edited\" INTEGER NOT NULL DEFAULT 0 CHECK (\"title_edited\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chat_turns",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_turns\" (\"conversation_id\" TEXT NOT NULL REFERENCES conversations (id) ON DELETE CASCADE, \"seq\" INTEGER NOT NULL, \"question\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, \"cited_entry_ids\" TEXT NOT NULL, \"stopped\" INTEGER NOT NULL DEFAULT 0 CHECK (\"stopped\" IN (0, 1)), \"vendor\" TEXT NOT NULL, \"model\" TEXT NOT NULL, \"asked_at\" TEXT NOT NULL, PRIMARY KEY (\"conversation_id\", \"seq\"));"
        }
      ]
    },
    {
      "name": "chat_usage",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_usage\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"at\" TEXT NOT NULL, \"question_key\" TEXT NOT NULL, \"vendor\" TEXT NOT NULL, \"model\" TEXT NOT NULL, \"fast_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"fast_mode\" IN (0, 1)), \"purpose\" TEXT NOT NULL, \"round\" INTEGER NOT NULL, \"temporary\" INTEGER NOT NULL CHECK (\"temporary\" IN (0, 1)), \"input_tokens\" INTEGER NOT NULL, \"output_tokens\" INTEGER NOT NULL, \"cache_read_tokens\" INTEGER NOT NULL, \"cache_write_tokens\" INTEGER NOT NULL, \"reasoning_tokens\" INTEGER NULL, \"wiki_index_notes\" INTEGER NOT NULL DEFAULT 0, \"wiki_index_chars\" INTEGER NOT NULL DEFAULT 0, \"read_wiki_calls\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
